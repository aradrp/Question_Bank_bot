# ─────────────────────────────────────────────────────────────
#  Telegram Question Bank Bot  –  Environment Configuration
# ─────────────────────────────────────────────────────────────

# Obtain your token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin Telegram user IDs
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=123456789

# Storage paths (inside the container)
UPLOADS_DIR=/app/uploads
LOGS_DIR=/app/logs
DB_PATH=/app/database/question_bank.db

# Maximum size of a single uploaded PDF (in megabytes)
MAX_FILE_SIZE_MB=50

# How many items to show per page in inline keyboards
ITEMS_PER_PAGE=8
